# 复制为 .env 后按现场修改；.env 不要提交到 Git
# 灰度期保持 true：只记录不下发
KSC2PAN_DRY_RUN=true
# 4 位以上随机串，设置后所有写操作需带 X-API-Token 头
KSC2PAN_TOKEN=

# mock = 只写 data/mock_pa_dag.jsonl（联调/演示）
# xmlapi = 真实推送到 PA（需要 PA_HOSTS + PA_API_KEY）
PA_MODE=mock
PA_HOSTS=10.0.0.1,10.0.0.2
# PAN-OS 管理员 API Key：https://<fw>/api/?type=keygen&user=svc-ksc2pan&password=***
PA_API_KEY=
